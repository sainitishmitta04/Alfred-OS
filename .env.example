TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
DB_PATH=alfred.db
AGENT_TIMEOUT_S=10
JEV_CONFIDENCE_THRESHOLD=0.6
JEV_TIMEOUT_S=5
FALLBACK_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-opus-5-5
AGENT_OVERRIDES=browser=browser_agent:BrowserAgent,direct=direct_agent:DIRECT
ALFRED_AGENT_MODEL=claude-haiku-4-5-20251001
ALFRED_MAX_TOOL_ROUNDS=6
# Colon-separated absolute paths; default Desktop, Documents, Downloads under $HOME
DESKTOP_FS_ALLOWED_DIRS=
CORS_ORIGINS=*
JEV_VERIFY=true
DESTRUCTIVE_THRESHOLD=0.5

# --- Voice input (app/) ---
# Speech-to-text: deepgram | openai. Switch at runtime from the tray menu.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.in.deepgram.com
OPENAI_API_KEY=
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=en
ORCHESTRATOR_URL=http://127.0.0.1:8000
HOTKEY=Alt+Space
# --- Browser Agent (browser_agent/) ---
# Browser agent models, tried in order. anthropic uses ANTHROPIC_API_KEY (Claude Opus 5 at low effort by default).
LLM_PROVIDERS=anthropic,gemini,openrouter
BROWSER_ANTHROPIC_MODEL=claude-opus-5
BROWSER_ANTHROPIC_EFFORT=low
# LLM providers tried in order; providers without a key are skipped
# free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# empty = auto-pick the newest free Flash models
GEMINI_MODELS=
OPENROUTER_API_KEY=
# comma-separated, tried in order; defaults to a vetted list of free tool-calling models
OPENROUTER_MODELS=
OPENROUTER_PLANNER_MODEL=
BROWSER_MAX_STEPS=15
BROWSER_TIMEOUT_S=120
BROWSER_HEADLESS=true
BROWSER_SNAPSHOT_CHARS=6000
BROWSER_RISKY_THRESHOLD=0.5
BRAVE_API_KEY=
